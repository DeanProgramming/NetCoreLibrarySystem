@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<link rel="stylesheet" href="~/css/identity.css" />

<div class="auth-page">
    <div class="auth-card">
        <section class="auth-main">
            <h1 class="auth-title">@ViewData["Title"]</h1>
            <p class="auth-subtitle">Use a local account to log in.</p>

            <form id="account" method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email"
                           class="form-control"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="name@example.com" />
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password"
                           class="form-control"
                           autocomplete="current-password"
                           aria-required="true"
                           placeholder="password" />
                    <label asp-for="Input.Password" class="form-label">Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-check mb-3 auth-remember">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label asp-for="Input.RememberMe" class="form-check-label">
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>

                <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">
                    Log in
                </button>

                <div class="auth-links mt-3">
                    <a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register</a>
                    <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend confirmation</a>
                </div>
            </form>
        </section>

        <aside class="auth-side">
            <h2 class="auth-side-title">Demo accounts</h2>
            <p class="auth-side-subtitle">Use these to test the system.</p>

            <div class="auth-note">
                <div class="auth-note-title">Admin</div>
                <div class="auth-note-body">
                    <div><strong>Email:</strong> Admin@Admin.com</div>
                    <div><strong>Password:</strong> Admin!1</div>
                    <div class="auth-muted mt-2">
                        Can create entries, book items out, and review users.
                    </div>
                </div>
            </div>

            <div class="auth-divider"></div>

            <div class="auth-note">
                <div class="auth-note-title">UserOne</div>
                <div class="auth-note-body">
                    <div><strong>Email:</strong> UserOne@UserOne.com</div>
                    <div><strong>Password:</strong> UserOne!1</div>
                    <div class="auth-muted mt-2">
                        Has some late books you can return and can browse items.
                    </div>
                </div>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
