@page
@model DeanHLibrarySite.Pages.Books.IndexModel

@{
    ViewData["Title"] = "Index";
} 

<h1>Library Listing</h1>

@if (Model != null && Model.IsAdmin)
{
    <p>
        <a asp-page="Create" class="btn btn-success">Create New Library Entry</a>
    </p>
}

<form class="library-form">
    <label for="SelectedBookTypes">Type of Media:</label>
    <select asp-for="SelectedBookTypes" asp-items="Model.BookTypes">
        <option value="">All</option>
    </select>

    <label for="Genre">Genre:</label>
    <select asp-for="Genre" asp-items="Model.Genres">
        <option value="">All</option>
    </select>

    <label for="Title">Title:</label>
    <input type="text" asp-for="Title" />

    <label for="Author">Author:</label>
    <input type="text" asp-for="Author" />

    <label for="PublicationYear">Publication Year:</label>
    <input type="date" id="publicationYear" asp-for="PublicationYear" />

    <input type="submit" value="Filter" class="btn btn-primary" />
</form>

<div id="pageNumberDisplay">
    <div class="pager"> 
        <div class="pager-left">
            @if (Model.PageNumber > 1)
            {
                <a href="@Url.Page("./Index", new { pageNumber = Model.PageNumber - 1, title = Model.Title, author = Model.Author, genre = Model.Genre, publicationYear = Model.PublicationYear, bookType = Model.SelectedBookTypes.ToString() })"
                   class="button-link">Previous</a>
            }
        </div> 
        <div class="pager-center">
            @if (Model.AmountOfPages != 0)
            {
                <span class="page-text">Page @Model.PageNumber / @Model.AmountOfPages</span>
            }
        </div> 
        <div class="pager-right">
            @if (Model.PageNumber < Model.AmountOfPages)
            {
                <a href="@Url.Page("./Index", new { pageNumber = Model.PageNumber + 1, title = Model.Title, author = Model.Author, genre = Model.Genre, publicationYear = Model.PublicationYear, bookType = Model.SelectedBookTypes.ToString() })"
                   class="button-link">Next</a>
            }
        </div> 
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th class="col-type">
                @Html.DisplayNameFor(model => model.BookTable[0].Type)
            </th>
            <th class="col-title">
                @Html.DisplayNameFor(model => model.BookTable[0].Title)
            </th>
            <th class="col-author">
                @Html.DisplayNameFor(model => model.BookTable[0].Author)
            </th>
            <th class="col-genre">
                @Html.DisplayNameFor(model => model.BookTable[0].Genre)
            </th>
            <th class="col-year">
                @Html.DisplayNameFor(model => model.BookTable[0].PublicationYear)
            </th>
            <th class="col-description">
                @Html.DisplayNameFor(model => model.BookTable[0].Description)
            </th>
            <th class="col-availability">
                <p>Availability</p>
            </th>
            <th class="col-actions"></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.BookTable) {
        <tr>
            <td class="col-type">@Html.DisplayFor(modelItem => item.Type)</td>
            <td class="col-title">@Html.DisplayFor(modelItem => item.Title)</td>
            <td class="col-author">@Html.DisplayFor(modelItem => item.Author)</td>
            <td class="col-genre">@Html.DisplayFor(modelItem => item.Genre)</td>
            <td class="col-year">@Html.DisplayFor(modelItem => item.PublicationYear)</td>
            <td class="col-description">@Html.DisplayFor(modelItem => item.Description)</td>
             <td class="col-availability">
                @if(Model != null && Model.BookAvailability != null)
                {
                    if (Model.BookAvailability.ContainsKey(item.Id) && Model.BookAvailability[item.Id] )
                    {         
                        if (Model.LoggedIn == false)
                        {
                            <p>This item is available to book this item you need to login and return to this page</p>
                        }
                        else
                        {
                            <p>Is Available</p>
                            if (Model.IsAdmin == false)
                            {
                                <a href="@Url.Page("./CreateBooking", new {id = item.Id, pageNumber = Model.PageNumber, title = Model.Title, author = Model.Author, genre = Model.Genre, publicationYear = Model.PublicationYear,  bookType = Model.SelectedBookTypes.ToString()})" class="button-link">Book</a>
                            }                               
                        }
                    }
                    else
                    {
                        @if (Model.BookReturnDateExpired.ContainsKey(item.Id) && Model.BookReturnDateExpired[item.Id])
                        {
                            <p> Should be returned. Contact library for further information</p>
                        }
                        else
                        {
                            <p>Return Date: @Model.BookReturnDates[item.Id]?.ToShortDateString()</p>
                        }
                    }   
                }
            </td>
            <td class="col-actions">
                <div class="action-buttons">
                    @if (Model != null && Model.IsAdmin)
                    {
                        <a href="@Url.Page("./Edit", new { id = item.Id, pageNumber = Model.PageNumber, title = Model.Title, author = Model.Author, genre = Model.Genre, publicationYear = Model.PublicationYear, bookType = Model.SelectedBookTypes.ToString() })"
                            class="button-link action-edit">Edit</a>

                        <a asp-page="./Delete"
                            asp-route-id="@item.Id"
                            class="button-link action-delete">Delete</a>

                        <a href="@Url.Page("../StaffControls/BookHistoryCheck", new { bookID = item.Id })"
                            class="button-link action-history">Check Book History</a>
                    }

                    <a href="@Url.Page("./Details", new { id = item.Id, pageNumber = Model.PageNumber, title = Model.Title, author = Model.Author, genre = Model.Genre, publicationYear = Model.PublicationYear, bookType = Model.SelectedBookTypes.ToString() })"
                        class="button-link action-details">Details</a>
                </div>
            </td> 
        </tr>
}
    </tbody>
</table>
